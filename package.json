{
  "name": "pmii-saintek-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/provision-admin.ts",
    "admin:reset": "tsx scripts/reset-admin.ts",
    "admin:revoke": "tsx scripts/revoke-admin-sessions.ts",
    "composio:smoke": "tsx --conditions=react-server scripts/composio-smoke.ts",
    "test:db": "tsx --conditions=react-server tests/integration/run.ts",
    "test:mapaba": "tsx --conditions=react-server --env-file=tests/empty.env tests/mapaba/registration-flow.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:db && npm run test:integration && npm run test:mapaba && npm run build",
    "test:unit": "tsx --conditions=react-server --env-file=tests/empty.env --test tests/unit/*.test.ts",
    "test:integration": "tsx --conditions=react-server --env-file=tests/empty.env --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@composio/core": "^0.17.0",
    "@node-rs/argon2": "2.2.2",
    "@vercel/blob": "2.8.1",
    "googleapis": "185.0.0",
    "next": "16.4.0",
    "node-html-parser": "7.0.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "3.3.3",
    "@next/env": "^16.4.0",
    "@types/node": "22.19.21",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
