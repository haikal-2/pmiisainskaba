  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/provision-admin.ts",
    "admin:reset": "tsx scripts/reset-admin.ts",
    "admin:revoke": "tsx scripts/revoke-admin-sessions.ts",
    "test:db": "tsx tests/integration/run.ts",
    "verify": "npm run typecheck && npm run lint && npm run test:db && npm run build"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@vercel/blob": "2.8.1",
