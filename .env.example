# Salin menjadi .env.local dan isi koneksi PostgreSQL lokal/test.
# Jangan memasukkan kredensial nyata ke repository.
APP_URL=http://localhost:3000
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_SSL=disable
ADMIN_PATH=admin-secret
ADMIN_SESSION_TTL_SECONDS=604800
ADMIN_MIN_PASSWORD_LENGTH=12
RATE_LIMIT_HASH_SALT=
# Identitas klien tepercaya untuk rate limit. Kosong = header forwarding tidak
# dipercaya dan seluruh trafik berbagi satu bucket (gagal tertutup). Isi hanya bila
# proxy platform benar-benar menimpa header ini (mis. `x-real-ip` di Vercel).
TRUSTED_CLIENT_IP_HEADER=
# Otorisasi job terjadwal (cron). Vercel Cron mengirim `Authorization: Bearer $CRON_SECRET`.
# Kosong = endpoint cron menolak semua permintaan (gagal tertutup).
CRON_SECRET=
# WAJIB di produksi: unggahan privat memakai Vercel Blob. Tanpa token ini produksi
# gagal keras (503); penyimpanan lokal hanya dipakai di non-produksi (.local-uploads/).
BLOB_READ_WRITE_TOKEN=
PUBLIC_ASSETS_BUCKET=public-assets
PRIVATE_MAPABA_BUCKET=private-mapaba
MAX_UPLOAD_BYTES=3145728
MAPABA_QUOTA=100
MAPABA_CLOSES_AT=2026-11-03T23:59:59+07:00
MAPABA_TIME_ZONE=Asia/Jakarta
MAPABA_CONTRIBUTION_LABEL=Rp75.000
MAPABA_FACULTY=Sains dan Teknologi
# Isi dengan URL Apps Script hasil deploy Anda sendiri; jangan pakai URL contoh.
GOOGLE_SHEETS_ADVOKASI_WEBHOOK_URL=
GOOGLE_SHEETS_MAPABA_WEBHOOK_URL=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_MAPABA_TAB=MAPABA
GOOGLE_SHEETS_ADVOCACY_TAB=Advokasi
UPLOAD_DRAFT_TTL_SECONDS=
# CAPTCHA untuk formulir publik (MAPABA & Advokasi). Widget klien memakai provider
# yang sama (reference-original/assets/js/captcha.js). Kosong = nonaktif (lokal).
# Di production, jika CAPTCHA_PROVIDER diisi, CAPTCHA_SECRET_KEY wajib diisi.
# CAPTCHA_PROVIDER=turnstile | recaptcha | recaptcha3
CAPTCHA_PROVIDER=
CAPTCHA_SECRET_KEY=
# Site key klien (public) untuk widget captcha di halaman form.
NEXT_PUBLIC_CAPTCHA_PROVIDER=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# Opsional: integrasi Composio Platform (@composio/core). Kosong = nonaktif.
# Kunci project (berawalan "ak_") tidak pernah dicetak atau disimpan di database.
COMPOSIO_API_KEY=
# Jangan memasukkan ADMIN_PASSWORD atau password default ke template.
# Rate limit, email dan pembayaran ditambahkan hanya setelah keputusan terkait.

